@@ -325,8 +325,11 @@ def pack_hand_result(res1: int, res2: int) -> bytes:
 
 def parse_join_game(payload: bytes) -> HostInfo:
     """STOC_JOIN_GAME payload -> HostInfo (raises ValueError when short)."""
-    if len(payload) < _HOSTINFO_FMT.size:
+    # (local patch, yugioh_AI_2: WindBot's older 56-byte HostInfo without the deck limits, as ygo-windbot

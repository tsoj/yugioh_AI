+// Iterating the pointer-keyed effect sets directly is both address dependent
+// (nondeterministic order) and unsafe: removing one effect can remove others
+// from the set, invalidating the iterator. Iterate a snapshot ordered by id.
+static std::vector<effect*> sorted_effects(const field_effect::effect_collection& set) {
+	std::vector<effect*> out(set.begin(), set.end());
+	std::sort(out.begin(), out.end(), [](const effect* a, const effect* b) { return a->id < b->id; });
+	return out;
+}
